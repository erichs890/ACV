{
  "name": "acv",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "core": "node --watch --disable-warning=ExperimentalWarning core/server.ts",
    "servidor": "node --disable-warning=ExperimentalWarning core/server.ts",
    "relato": "node --disable-warning=ExperimentalWarning core/relato.ts",
    "check": "node --disable-warning=ExperimentalWarning core/self-check.ts && node --disable-warning=ExperimentalWarning core/fila-check.ts && node --disable-warning=ExperimentalWarning core/envio-check.ts && node --disable-warning=ExperimentalWarning core/adapters-envio-check.ts && node --disable-warning=ExperimentalWarning core/extensao-check.ts",
    "build": "biome check . && tsc --noEmit && tsc -p core && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "lucide-react": "^1.44.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
