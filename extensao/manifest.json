{
  "manifest_version": 3,
  "name": "ACV",
  "version": "0.2.0",
  "description": "Diz se a plataforma exige conta e o que falta no seu perfil, e candidata na vaga aberta quando você manda. Guarda a própria configuração e funciona com o ACV fechado.",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:4780/*"],
  "background": {
    "service_worker": "fundo.js"
  },
  "options_page": "opcoes.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["comum.js", "ui/tema.js", "ui/orbe.js", "ui/plataformas.js", "ui/acao.js", "conteudo.js", "motor.js", "painel.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "css": ["ui/fonte.css"]
    },
    {
      "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.gupy.io/*"],
      "js": ["rede.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACV",
    "default_icon": {
      "16": "ui/marca/icone-16.png",
      "32": "ui/marca/icone-32.png",
      "48": "ui/marca/icone-48.png"
    }
  },
  "icons": {
    "16": "ui/marca/icone-16.png",
    "32": "ui/marca/icone-32.png",
    "48": "ui/marca/icone-48.png",
    "128": "ui/marca/icone-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/tokens.css", "ui/marca.css", "ui/base.css", "ui/painel.css", "ui/fontes/*.woff2"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": false
    }
  ]
}
